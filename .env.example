TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_IDS=
DATABASE_URL=file:../data/alerts.db
# Docker Compose overrides this to file:/data/alerts.db
OLLAMA_HOST=http://127.0.0.1:11434
# Docker Compose overrides this to http://ollama:11434
OLLAMA_MODEL=qwen3.5:2b-mlx
OLLAMA_KEEP_ALIVE=-1
SCRAPE_INTERVAL_MS=3000
SCRAPE_CONCURRENCY=4
LLM_BATCH_SIZE=6
LLM_BATCH_WAIT_MS=2000
LLM_ALERT_WAIT_MS=150
ALERT_SEND_CONCURRENCY=8
PORT=8080
NODE_ENV=development

# Public HTTPS URL (needed for Viber webhook auto-register)
PUBLIC_BASE_URL=

# WhatsApp Cloud API — free tier. Webhook: GET/POST {PUBLIC_BASE_URL}/webhooks/whatsapp
# User sends a location pin in the WhatsApp chat to subscribe / update geo.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=uk

# Viber Bot API. Webhook: POST {PUBLIC_BASE_URL}/webhooks/viber
# User sends a location pin in the Viber chat to subscribe / update geo.
VIBER_AUTH_TOKEN=
VIBER_URI=
VIBER_SENDER_NAME=AlertsNest
